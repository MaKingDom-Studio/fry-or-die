## Настройки магазина. Настраивается в _Game/Data/Shop/da_shop.tres.
##
## Здесь — пулы товаров и правила генерации витрины ([ShopInventory]).
## Цена и вес выпадения каждого товара — в конфиге самого товара:
## [member IngredientModel.price] / [member IngredientModel.shop_weight]
## и [member SpiceModel.price] / [member SpiceModel.shop_weight].
class_name ShopConfig
extends Resource

@export_group("Пулы товаров")
## Ингредиенты, которые могут появиться на витрине. По размеру
## ([member IngredientModel.size]) сами раскладываются по рядам:
## большие и средние — в первый ряд, средние и маленькие — во второй.
@export var ingredient_pool: Array[IngredientModel] = []
## Специи третьего ряда витрины.
@export var spice_pool: Array[SpiceModel] = []

@export_group("Правила генерации")
## Сколько позиций в каждом из трёх рядов витрины.
@export var slots_per_row := 3
## «Жалость» первого ряда: каждый выпавший средний ингредиент умножает
## вес больших на (1 + бонус * число выпавших средних) — чем больше
## средних выпало, тем выше шанс большого.
@export var large_weight_bonus_per_medium := 0.5
## Во втором ряду гарантировать минимум один товар с эффектом
## ([member IngredientModel.effect]).
@export var require_effect_item := true
## Множитель веса специи, которая уже есть у игрока
## (0.75 — вес ниже на 25%).
@export_range(0.0, 1.0) var owned_spice_weight_multiplier := 0.75

@export_group("Баланс")
## Стартовый запас звёзд игрока при входе в магазин (валюта покупок).
@export var starting_stars := 25

@export_group("Тень товара")
## Насколько тень выезжает из-под лежащего товара, px. Совсем немного —
## из-под товара видна только тонкая полоска тени.
@export var shadow_rest_offset := 1.5
## Прозрачность тени лежащего товара — доля от цвета тени темы
## (меньше — тень бледнее и незаметнее).
@export_range(0.0, 1.0) var shadow_rest_alpha := 0.45
## Насколько тень отъезжает, когда товар взяли в руку, px: чем больше,
## тем «выше» поднят товар.
@export var shadow_lift_offset := 15.0
## Во сколько раз тень вырастает у товара в руке.
@export var shadow_lift_scale := 1.18
## Прозрачность тени поднятого товара — тоже доля от цвета тени темы.
## Больше, чем у лежащего: поднятый товар отбрасывает заметную тень.
@export_range(0.0, 1.0) var shadow_lift_alpha := 0.75
## Скорость роста и уменьшения тени, доля в секунду: 6 — полный переход
## примерно за 0.17 с. Взяли товар — тень постепенно растёт, отпустили —
## так же плавно уменьшается.
@export var shadow_speed := 6.0

@export_group("Перенос товара")
## Скорость, с которой взятый товар догоняет курсор (доля пути за тик).
@export_range(0.05, 1.0) var carry_follow := 0.35
## Длительность возврата товара на полку, если его отпустили мимо
## холодильника, с.
@export var return_duration := 0.35
## Длительность «улёта» купленного товара внутрь холодильника, с.
@export var consume_duration := 0.3
