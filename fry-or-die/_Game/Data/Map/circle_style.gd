## Обводка точки карты — нарисованный от руки овал (Circle_01…Circle_03).
##
## `Circle_01`, `Circle_02`, `Circle_03` — не кадры анимации, а три разных
## овала: каждая новая обводка берёт следующий по очереди, поэтому две
## подряд не выглядят одинаково. Внутри одной обводки картинка не меняется.
##
## Появляется обводка не сразу: карандаш обводит точку по кругу. Уходит
## так же — карандаш стирает её обратным ходом ([MapCircle]).
##
## Порядок на экране: обводка сначала стоит на точке, где игрок находится;
## как только он выбрал уровень, она стирается там и рисуется на выбранной
## точке — и только когда дорисована, карта запускает уровень. На каком
## слое графа она лежит, задаёт [member layer].
class_name CircleStyle
extends Resource

## На каком слое графа лежит обводка.
enum Layer {
	## Под дорогами: обводка нарисована на самой карте, линии идут по ней.
	UNDER_LINES,
	## Поверх дорог, но под листками точек.
	OVER_LINES,
	## Поверх всего графа, включая листки точек.
	OVER_POINTS,
}

@export_group("Слой")
## Что закрывает обводку, а что она сама. Ниже фона панели она не уходит
## никогда.
@export var layer: Layer = Layer.OVER_LINES

@export_group("Варианты овала")
## Варианты овала: `Circle_01`, `Circle_02`, `Circle_03` из `_Game/Art/Map/`.
## Берутся по очереди, по одному на обводку. Пока их нет, обводка рисуется
## дугой цветом [member color].
@export var variants: Array[Texture2D] = []
## Цвет, которым красится картинка (и которым рисуется дуга без картинок).
@export var color := Color(0.85, 0.29, 0.13)

@export_group("Размер")
## Размер овала, px.
@export var size := Vector2(124.0, 108.0)
## Сдвиг овала от точки, px.
@export var offset := Vector2(0.0, 0.0)

@export_group("Ход карандаша")
## Сколько карандаш обводит точку, с.
@export var draw_time := 0.34
## Сколько стирает, с.
@export var erase_time := 0.2
## Пауза между «дорисовали» и запуском уровня, с.
@export var hold_time := 0.18
## Откуда карандаш начинает вести, градусы (180 — слева, как на картинке).
@export_range(-360.0, 360.0, 1.0) var start_angle_degrees := 180.0
## Ведёт ли карандаш по часовой стрелке.
@export var clockwise := true
## Из скольких кусков собирается недорисованная обводка. Больше — ровнее
## край линии.
@export_range(8, 128, 1) var segments := 48

@export_group("Дуга без картинок")
## Толщина дуги-заглушки, px.
@export var stroke_width := 5.0


## Овал под номером `index` по очереди; null — картинок нет.
func variant(index: int) -> Texture2D:
	if variants.is_empty():
		return null
	return variants[posmod(index, variants.size())]


## Направление обхода: +1 по часовой стрелке (ось y на экране смотрит вниз).
func direction() -> float:
	return 1.0 if clockwise else -1.0
