## Как выглядит один вид точки карты: листок магазина, боя, минибосса,
## босса или входа в кухню.
##
## Один такой ресурс — один «объект» карты, который можно менять в
## редакторе: подставить другую картинку, поменять размер, наклон и место
## прокола. Все виды точек собраны в [MapStyle] по полям
## `art_enemy` / `art_miniboss` / `art_shop` / `art_boss` / `art_start`,
## поэтому вид точки правится без единой строчки кода.
##
## Картинки лежат в `_Game/Art/Map/`: `Map_Sheet_Battle` — обычный бой,
## `Map_Sheet__Mini_Boss_Battle` — минибосс, `Map_Sheet_Supermarket` —
## магазин, `Map_Sheet_Boss_Battle` — финальный босс.
##
## У минибосса листок свой, с его орудием (`Map_Sheet__Mini_Boss_Tongie`,
## `…_Fireman`, `…_Fishman`): такой листок лежит не в [MapStyle], а в самом
## враге — [member EnemyModel.map_art], и перебивает общий листок типа
## точки (см. [method MapStyle.art_for_node]).
class_name MapPointArt
extends Resource

@export_group("Картинка")
## Листок точки. Рисуется после нити графа, поэтому закрывает её собой.
@export var texture: Texture2D
## Часть листка выше прокола — рисуется до нити графа, если картинка
## разрезана на две части (как листки на игле). Пусто — листок цельный.
@export var back_texture: Texture2D
## Размер листка на карте, px.
@export var size := Vector2(88.0, 80.0)
## Где у листка «гвоздик»: за эту точку он и висит на карте, в долях
## листка. Ею же листок притягивается к своему месту в графе.
@export var pivot := Vector2(0.5, 0.42)
## Наклон листка, градусы: знак чередуется через точку, чтобы карта
## не выглядела расчерченной по линейке.
@export var tilt_degrees := 0.0
## Насколько крупнее обводка ([CircleStyle]) вокруг этой точки: у босса
## листок больше, значит и овал должен быть больше.
@export_range(0.3, 3.0, 0.01) var circle_scale := 1.0

@export_group("Заглушка без картинки")
## Пока картинки нет, точка рисуется бумажным прямоугольником с этой
## буквой: S — магазин, M — минибосс, B — босс.
@export var letter := ""
## Рисовать ли обводку и дырку у заглушки.
@export var draw_paper := true


## Наклон в радианах; sign переворачивает его для чётных/нечётных точек.
func tilt(sign_value := 1.0) -> float:
	return deg_to_rad(tilt_degrees) * sign_value
