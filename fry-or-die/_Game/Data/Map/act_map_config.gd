## Наполнение карты забега: сколько чего на карте и кем населены точки.
## Настраивается в `_Game/Data/Map/da_map_act1.tres`.
##
## Карта — вступление одной общей линией и линии от его магазина наверх
## к боссу (см. [ActMap]). Правила, которые генератор соблюдает всегда:
##
## - первые три боя забега всегда одни и те же — [member first_enemy],
##   [member second_enemy] и [member third_enemy]: они идут одной общей
##   линией, следом стоит общий магазин, и только от него линии
##   расходятся к первым минибоссам;
## - на каждой линии ровно [member minibosses_per_branch] минибосса
##   и минимум [member shops_per_branch_min] магазин;
## - обычные бои сверх вступления делятся между линиями поровну
##   ([member enemies_total] на всю карту, вместе со вступлением);
## - нижний минибосс каждой линии — из [member first_miniboss_pool]
##   (Tongie и Fireman): их встречают самыми первыми;
## - магазин всегда стоит вплотную перед минибоссом — к минибоссу
##   игрок приходит подготовленным;
## - магазин перед последними минибоссами один на все линии
##   ([member shared_shop_before_last_miniboss]);
## - линии сходятся в общем магазине ([member shop_before_boss]),
##   за которым стоит босс.
class_name ActMapConfig
extends Resource

@export_group("Размер карты")
## Сколько линий расходится от входа в кухню.
@export_range(2, 4) var branches := 2
## Сколько обычных боёв на всей карте, вместе с тремя боями вступления
## (остальные делятся между линиями поровну).
@export var enemies_total := 7
## Сколько минибоссов на каждой линии.
@export_range(1, 4) var minibosses_per_branch := 2
## Минимум магазинов на линии — правило «на линии всегда есть магазин».
## Общий магазин перед последними минибоссами в этот минимум засчитывается.
@export_range(1, 4) var shops_per_branch_min := 1
## Сколько всего магазинов на карте, вместе с общими. Настоящее число
## роллится в этих границах и подрезается под то, сколько мест вообще есть
## (по одному перед каждым минибоссом). При двух минибоссах на линии
## свободных мест нет, и магазинов ровно три: вступление, перед
## последними минибоссами и перед боссом.
@export var shops_min := 3
@export var shops_max := 3
## Магазин перед последними минибоссами — один общий на все линии: линии
## сходятся к нему, и уже из него игрок выбирает, к чьему минибоссу идти.
## Магазины в сегментах ниже у каждой линии свои.
@export var shared_shop_before_last_miniboss := true
## Общий магазин, в котором сходятся линии перед боссом.
@export var shop_before_boss := true

@export_group("Кто стоит на точках")
## Первый бой забега — всегда он. Первые три боя идут одной общей линией
## до магазина перед первыми минибоссами ([ActMap]).
@export var first_enemy: EnemyModel
## Второй бой забега — всегда он.
@export var second_enemy: EnemyModel
## Третий бой забега — всегда он.
@export var third_enemy: EnemyModel
## Из этого пула набираются бои линий выше первых минибоссов (без
## повторов, пока пул не кончится; потом пул тасуется заново).
@export var enemy_pool: Array[EnemyModel] = []
## Самые первые минибоссы забега: нижний минибосс каждой линии берётся
## только из этого пула (Tongie и Fireman) — их игрок и встречает первыми.
## Раздаются без повторов, поэтому на разных линиях стоят разные.
@export var first_miniboss_pool: Array[EnemyModel] = []
## Остальные минибоссы: раздаются по карте без повторов, пока их хватает.
@export var miniboss_pool: Array[EnemyModel] = []
## Босс в конце забега.
@export var boss: EnemyModel

@export_group("Раскладка")
## Высота, на которой стоит общий магазин перед боссом (0 — низ, 1 — верх).
@export_range(0.0, 1.0) var hub_row_frac := 0.9
## Выше какой доли высоты линии не забираются — над ними остаётся место
## под общий магазин и босса.
@export_range(0.1, 1.0) var branch_top_frac := 0.82
## Насколько сильно кружки «гуляют» от идеальной линии, 0..1 (карта
## нарисована от руки). Множитель в пикселях — в [MapStyle].
@export_range(0.0, 1.0) var wobble := 0.5
