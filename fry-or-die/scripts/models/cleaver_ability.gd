## Способность тесака: в начале раунда лезвие рубит ровно по центру стола.
## От удара подпрыгивает всё, что лежит на столе, — кроме того, по чему
## пришлось само лезвие: задетое лезвие не подбрасывает, а медленно двигает
## с центра на половину хозяина удара.
##
## Одним и тем же ресурсом ходят обе стороны: минибосс ([EnemyModel.cleaver])
## увозит задетое к себе, тесак игрока ([ToolCleaver]) — к игроку. Сторону
## сдвига задаёт режим боя, а не сама способность.
##
## Стол виден сверху, поэтому и тесак виден только сверху ([member texture],
## Cleaver_TOP): он появляется прямо над центром стола крупным — как далёкий,
## занесённый высоко, — и уменьшается, пока падает. Настоящий размер лезвия
## (масштаб 1) — это и есть касание стола.
##
## Способность разыгрывается после того, как всё высыпалось на стол, и до
## того, как игрок сможет нажать «Обратный отсчёт», поэтому сдвинутое успевает
## улечься и посчитается уже в пользу хозяина удара.
##
## Настраивается в _Game/Data/Combat/Enemies/da_ability_cleaver.tres (враг)
## и _Game/Data/Combat/Tools/da_tool_cleaver.tres (игрок), сам удар и сдвиг
## рисует узел [CleaverNode].
class_name CleaverAbility
extends Resource

## Смещение линии удара от центра зоны высыпания, px: 0 — тесак бьёт ровно
## по середине стола, плюс — ближе к хозяину удара (врагу у минибосса,
## игроку у тесака игрока).
@export var strike_line_offset := 0.0

## Как часто минибосс бьёт тесаком: 1 — каждый раунд, 2 — через раунд
## (1-й, 3-й, 5-й...), 3 — каждый третий. Первый раунд всегда с ударом.
## У тесака игрока не спрашивается: там «через раунд» делает кулдаун
## инструмента.
@export_range(1, 10) var every_n_rounds := 2

@export_group("Волна")
## На какую высоту подпрыгивают продукты, которых лезвие не задело, px.
@export var hop_height := 65.0
## Разброс высоты подскока, px: стол подлетает неровно.
@export var hop_height_variance := 20.0
## Ускорение падения подскока, px/s^2: чем больше, тем резче подскок.
@export var hop_gravity := 2600.0
## Доля скорости, которая остаётся после касания стола: мелкие затухающие
## подскоки после основного.
@export_range(0.0, 0.9) var hop_bounce := 0.3

@export_group("Сдвиг")
## На сколько лезвие увозит задетое с центра в сторону хозяина удара, px.
@export var push_distance := 75.0
## Скорость сдвига, px/s. Специально медленная: задетое отъезжает вместе
## с лезвием, а не разлетается по столу.
@export var push_speed := 85.0

@export_group("Лезвие")
## Изображение лезвия — вид сверху (Cleaver_TOP). Другого вида у тесака нет:
## стол всегда виден сверху.
@export var texture: Texture2D
## Длина лезвия на столе в момент касания, px: по ней считается масштаб
## изображения (пропорции сохраняются).
@export var blade_length := 380.0
## Сдвиг лезвия от точки удара, px.
@export var blade_offset := Vector2.ZERO
## Насколько полоса удара шире изображения лезвия, px. Минус — уже: так можно
## выкинуть из полосы рукоять.
@export var hit_grow := 0.0
## Слой отрисовки: выше стола и корзин (90/91), ниже HUD (100).
@export var draw_z_index := 96

@export_group("Удар")
## Во сколько раз лезвие крупнее в момент появления: оно занесено высоко над
## столом, поэтому кажется больше, и уменьшается, пока падает.
@export var entry_scale := 2.2
## Прозрачность в момент появления (0..1): занесённый тесак ещё только
## проявляется над столом и к удару становится плотным.
@export_range(0.0, 1.0) var entry_alpha := 0.35
## Во сколько раз лезвие крупнее к концу замаха — перед самым ударом.
@export var raise_scale := 1.5
## Наклон лезвия в замахе, рад: к удару оно выпрямляется.
@export var raise_tilt := -0.15
## Сколько длится появление и подлёт (уменьшение до [member raise_scale]), с.
@export var raise_duration := 0.45
## Сколько длится сам удар: лезвие падает до настоящего размера, с.
@export var chop_duration := 0.12
## Пауза с лезвием на столе, с — до того, как оно поедет в свою сторону.
@export var hold_pause := 0.22
## Сколько длится уход со стола, с: лезвие поднимается — снова растёт и тает.
@export var retreat_duration := 0.4
## Пауза после удара, с — сдвинутые ингредиенты успевают улечься.
@export var settle_pause := 0.5


## Бьёт ли тесак в раунде round_number (с 1): удар идёт через каждые
## [member every_n_rounds] раундов, начиная с первого. Спрашивает только
## минибосс: тесак игрока бьёт в том раунде, в котором его выбрали.
func strikes_on_round(round_number: int) -> bool:
	if every_n_rounds <= 1:
		return true
	return (round_number - 1) % every_n_rounds == 0


## Сколько длится сдвиг задетого: расстояние на скорости [member push_speed].
## 0 — сдвига нет.
func push_duration() -> float:
	if push_distance <= 0.0 or push_speed <= 0.0:
		return 0.0
	return push_distance / push_speed
