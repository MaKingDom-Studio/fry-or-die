## Один настроенный вручную ход врага: что он высыпает в этом раунде.
##
## Ход состоит из групп ([EnemySpawnGroup]) — каждая кладёт свой ингредиент
## (или случайный набор) на свой участок стола ([enum EnemySpawnGroup.Placement]:
## половина врага, половина игрока или центр). Так один ход может одновременно
## подкинуть врагу очков и подбросить игроку вредный ингредиент.
class_name EnemyMove
extends Resource

## Группы выкладки этого хода. Разворачиваются в порядке списка.
@export var groups: Array[EnemySpawnGroup] = []

## Разыгрывает ли враг в этом ходе свою способность ([member EnemyModel.tongs]).
## Способность идёт после того, как всё высыпалось на стол, и до того, как
## игрок сможет нажать «Обратный отсчёт».
@export var uses_ability := false
