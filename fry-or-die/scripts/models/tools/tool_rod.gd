## Удочка игрока: после выбора инструмента крюк вылетает из-за края стола
## слева, цепляет самый далёкий от игрока полезный ингредиент и тянет его
## к игроку — до середины его половины стола.
##
## Зеркало способности минибосса-рыбака «Fishman» ([HookAbility]): заброс
## рисует тот же узел [HookNode], только удилище стоит со стороны игрока и
## добыча едет не к врагу, а к нему. Вдобавок удочка позволяет трогать
## (перетаскивать) ингредиенты в области врага.
class_name ToolRod
extends ToolModel

## Изображение крюка, траектория заброса и число целей за раунд.
## Настраивается в _Game/Data/Combat/Tools/da_tool_rod.tres.
@export var ability: HookAbility


func get_hook_ability() -> HookAbility:
	return ability


func can_touch_enemy_area() -> bool:
	return true
