## Способность крюка: в начале раунда хозяин забрасывает крюк за самым
## дальним от себя полезным ингредиентом и тянет его к себе, пока тот
## не окажется на его половине стола.
##
## Одним и тем же ресурсом ходят обе стороны: минибосс-рыбак
## ([EnemyModel.hook]) забрасывает справа и тянет к себе, удочка игрока
## ([ToolRod]) — слева и к игроку. Где стоит удилище и куда тянуть, задаёт
## режим боя, а не сама способность.
##
## Способность разыгрывается после того, как всё высыпалось на стол, и до
## того, как игрок сможет нажать «Обратный отсчёт», так что добыча успевает
## доехать и посчитается уже в пользу хозяина крюка. Крюк вылетает из-за края
## стола по дуге, цепляется за ингредиент и тянет его физически: добыча едет
## по столу и расталкивает всё на пути. Если ингредиент застрял (упёрся
## в стену или в кучу), тяга кончается по таймауту ([member pull_timeout]).
##
## Настраивается в _Game/Data/Combat/Enemies/da_ability_hook.tres (враг)
## и _Game/Data/Combat/Tools/da_tool_rod.tres (игрок), сам заброс рисует
## узел [HookNode].
class_name HookAbility
extends Resource

## Сколько ингредиентов утягивается за одно применение.
@export var pull_count := 1

@export_group("Вид")
## Изображение крюка; если не задано, крюк рисуется сам (цевьё, загиб, жало).
@export var texture: Texture2D
## Масштаб изображения на столе.
@export var image_scale := 0.12
## Отразить изображение по горизонтали (точка зацепа остаётся на месте).
@export var mirror := false
## Точка зацепа в долях изображения (0..1): место, которым крюк держит
## добычу — у Hook.png это изгиб, в него ингредиент и ложится. Именно она
## наводится на ингредиент, за неё же добыча и едет, и вокруг неё крюк
## разворачивается. У рисованного крюка (изображения нет) зацеп — жало.
@export var hook_anchor := Vector2(0.5, 0.5)
## Точка привязки лески в долях изображения (0..1): ушко крюка. К ней тянется
## леска от удилища, за неё же крюк разворачивается ([member aim_at_rod]).
@export var eye_anchor := Vector2(0.9, 0.17)
## Разворачивать изображение так, чтобы ушко смотрело на удилище: крюк тогда
## всегда висит на леске правильной стороной, куда бы он ни летел, — ушко
## к удилищу, изгиб с добычей от него. Доводится до нужного вида
## [member image_rotation]. Выключено — изображение висит как нарисовано;
## рисованному крюку (изображения нет) разворот не нужен.
@export var aim_at_rod := true
## Доворот изображения поверх наводки, градусы: им крюк кладут вдоль лески.
## Наводка ставит на удилище линию «зацеп → ушко», а цевьё нарисовано под
## углом к ней, поэтому без доворота крюк стоит торчком. Поворот идёт вокруг
## точки зацепа, так что наводка на добычу не сбивается, а леска приходит
## в ушко в любом случае.
@export_range(-180.0, 180.0, 1.0) var image_rotation := 0.0
## Размер рисованного крюка, px (когда изображения нет).
@export var hook_size := 9.0
@export var hook_color := Color(0.85, 0.87, 0.9, 1.0)
## Леска от удилища за краем стола до крюка.
@export var line_color := Color(0.92, 0.93, 0.95, 0.75)
@export var line_width := 2.0
## Слой отрисовки: выше стола и корзин (90/91), ниже HUD (100).
@export var draw_z_index := 96

@export_group("Заброс")
## Точка заброса и ухода — отступ от нижнего угла стола со стороны хозяина:
## оттуда тянется леска, туда же крюк уходит в конце. По x отступ уводит точку
## за край стола (у врага — за правый, у игрока — за левый), а отрицательный y
## поднимает её от нижнего угла до середины высоты — крюк вылетает сбоку,
## а не снизу.
@export var entry_offset := Vector2(380.0, -170.0)
## Сколько длится заброс к ингредиенту, с.
@export var cast_duration := 1.5
## Пауза на зацепе, с.
@export var hook_pause := 0.5
## Сколько длится уход со стола, с. Уходит крюк по прямой — без дуги.
@export var retreat_duration := 1.0
## Кривизна траектории заброса: отклонение середины пути вбок, px,
## и случайная добавка к нему (в обе стороны).
@export var path_arc := 90.0
@export var path_arc_random := 60.0

@export_group("Подтягивание")
## Насколько близко к своей точке (середине половины хозяина) надо подтянуть
## добычу, чтобы считать её доставленной, px. Дошла — крюк отпускает её,
## а стол замирает: ни добыча, ни расталканные ею соседи не разъезжаются
## дальше (трение стола слабое, иначе они катятся почти весь раунд).
@export var arrive_distance := 24.0
## Жёсткость «лески»: с какой силой крюк тянет добычу. Заменяет на время
## подтягивания собственную жёсткость перетаскивания ингредиента. Чем
## меньше, тем медленнее и тяжелее едет добыча (у мыши — 60).
@export var pull_stiffness := 55.0
## Сколько секунд крюк тянет ингредиент, прежде чем сдаться: страховка на
## случай, если добыча упёрлась в стену или застряла в куче.
@export var pull_timeout := 7.0
## Пауза после того, как добыча доехала, с — ингредиенты успевают улечься.
@export var settle_pause := 0.5
