## Модель врага: цель по звёздам, настроенные вручную ходы и усиление.
##
## Враг ходит в начале раунда, перед высыпанием игрока: высыпает содержимое
## своего хода. Ход — список групп ([EnemyMove] → [EnemySpawnGroup]); у каждой
## группы свой участок стола, поэтому один ход может класть и врагу, и игроку,
## и в центр. Ходы задаются вручную списком [member moves] и зациклены.
## Усиление: каждый N-й раунд враг получает в корзину вечный ингредиент,
## который падает на его сторону и остаётся между раундами.
class_name EnemyModel
extends Resource

@export var id: StringName
@export var display_name := ""
## Внешность в HUD боя (портрет-текстура или рисованный повар).
@export var portrait: PortraitStyle

## Характеристика врага: сколько звёзд нужно заполнить, чтобы победить его.
## Цели заданы «крест-накрест» — это число идёт игроку, а врагу цель берётся
## из [member CombatConfig.player_star_target]. В HUD этот ряд стоит у игрока.
@export var star_target := 5

## Свой таймер раунда в бою против этого врага, с: заменяет базу боя
## ([member CombatConfig.round_timer_seconds]). Прибавки эффектов (лимон)
## и специй работают поверх него. 0 — таймер из конфига боя.
@export var round_timer_seconds := 0.0

## Множитель количества всех ингредиентов, которые высыпает враг: 1 — как в
## ходах, 2 — вдвое больше штук (очки за каждый ингредиент не меняются).
## Для группы со случайным набором умножается её ценность в очках.
@export var spawn_count_multiplier := 1

## Инвентарь врага: ингредиенты, которыми он вообще пользуется. Из него
## набираются группы со случайным набором ([member EnemySpawnGroup.random_points]).
@export var inventory: Array[IngredientModel] = []

## Ходы врага, настраиваются вручную: раунд N использует ход
## с индексом (N - 1) % moves.size(), то есть список зациклен.
@export var moves: Array[EnemyMove] = []

@export_group("Усиление")
## Каждый N-й раунд враг получает в корзину [member empower_ingredient].
## 0 — усиление выключено.
@export var empower_every_n_rounds := 0
## Вечный ингредиент усиления: падает на сторону врага, остаётся между
## раундами, его нельзя трогать и сбить — только выжечь горелкой.
@export var empower_ingredient: IngredientModel
## Максимум вечных ингредиентов на поле одновременно.
@export var empower_limit := 10

@export_group("Сжигание")
## Сколько ингредиентов враг сжигает у игрока в конце каждого хода: он выбирает
## самые ценные на поле игрока (очки — с учётом специй) и выжигает их прямо
## перед подсчётом, так что эти очки игрок не получает. Сгорают только
## ингредиенты в плюс — жечь вредные врагу невыгодно. 0 — сжигания нет.
@export var burn_player_ingredients := 0

@export_group("Способность")
## Щипцы минибосса: в ходах с [member EnemyMove.uses_ability] он утаскивает
## к себе ингредиенты с нейтральной зоны стола. null — способности нет.
@export var tongs: TongsAbility
## Крюк минибосса-рыбака: в начале каждого раунда он цепляет самый дальний
## от себя полезный ингредиент и тянет его, пока тот не окажется на его
## половине стола. Работает в любом ходе, [member EnemyMove.uses_ability]
## ему не нужен. null — способности нет.
@export var hook: HookAbility
## Тесак минибосса: в начале каждого раунда он бьёт по середине стола и
## сметает всё правее линии удара себе на половину — зеркало тесака игрока.
## Работает в любом ходе. null — способности нет.
@export var cleaver: CleaverAbility
## Прячет подсказки по ингредиентам на столе, пока идёт раунд: с нажатия
## кнопки «Обратный отсчёт» и до нуля таймера навести на ингредиент и узнать,
## что он даёт, нельзя — игрок разбирает стол по памяти. Как только таймер
## кончился, подсказки снова работают (в том числе на подсчёте).
## Корзин, мешка, полки специй и окон HUD это не касается.
@export var hides_field_tooltips := false

@export_group("Награда")
## Инструмент, который игрок забирает себе за победу над этим врагом:
## минибосс отдаёт своё орудие (пожарный — газовую горелку). Инструмент
## попадает в инвентарь игрока ([member Player.tools]) и дальше живёт как
## купленный — выбирается перед раундом и уходит в кулдаун.
## null — за победу инструмент не дают; если такой инструмент у игрока
## уже есть, награда пропускается (дубликаты не выдаются).
@export var reward_tool: ToolModel

@export_group("Эффекты")
## Из этого списка сэмплятся дополнительные ингредиенты, когда эффект дал
## врагу «+N ингредиентов на следующий ход». Падают на сторону врага.
@export var extra_pool: Array[IngredientModel] = []

## Из этого списка сэмплятся группы со случайным мусором
## ([member EnemySpawnGroup.random_bad_count]) — вредные ингредиенты, которыми
## враг заваливает стол. Пусто — берутся вредные ингредиенты
## из [member inventory].
@export var bad_pool: Array[IngredientModel] = []

## Из этого списка сэмплятся группы со случайным эффектом
## ([member EnemySpawnGroup.random_effect_count]) — здесь держат ингредиенты
## с эффектом, чтобы они не попадали в обычные случайные наборы по очкам.
## Пусто — эффектные ингредиенты берутся из [member inventory].
@export var effect_pool: Array[IngredientModel] = []

@export_group("Карта")
## Последний босс акта: победа над ним заканчивает забег и открывает финальный
## экран ([EndScreen] — картинка END.png и кнопка перезапуска). В забеге то же
## самое видно по точке карты ([constant MapNode.Kind.BOSS]), а этот флаг нужен
## бою, запущенному из редактора отдельно, — там карты нет.
@export var is_final_boss := false

## Свой листок этого врага на карте забега: у каждого минибосса на листке
## нарисовано его орудие — щипцы у Tongie, огонь у Fireman, крюк у Fishman.
## Листки лежат в `_Game/Data/Map/Points/`, картинки — в `_Game/Art/Map/`.
## null — точка рисуется общим листком своего типа из [MapStyle]
## (`art_enemy` / `art_miniboss` / `art_boss`).
@export var map_art: MapPointArt


## Ход для раунда round_number (с 1); null, если ходов нет.
func move_for_round(round_number: int) -> EnemyMove:
	if moves.is_empty():
		return null
	return moves[(round_number - 1) % moves.size()]


## Положено ли усиление в раунде round_number.
func is_empower_due(round_number: int) -> bool:
	return empower_every_n_rounds > 0 \
			and empower_ingredient != null \
			and round_number % empower_every_n_rounds == 0
