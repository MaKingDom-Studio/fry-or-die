## Способность минибосса-щипцов ([EnemyModel.tongs]): перед раундом он
## утаскивает к себе ингредиенты с нейтральной зоны стола.
##
## Способность разыгрывается в ходах, отмеченных [member EnemyMove.uses_ability],
## после того как всё высыпалось на стол и до того, как игрок сможет нажать
## «Обратный отсчёт». Щипцы прилетают справа снизу за границей стола, наводятся
## на ингредиент (изображение [member open_texture]), смыкаются на нём
## ([member close_texture]), перетаскивают на половину врага и разжимаются.
## Траектория подлёта и переноса — дуга со случайным разбросом и мелким
## покачиванием, которое гаснет к цели, чтобы губки точно легли на ингредиент;
## со стола щипцы уходят по прямой.
##
## Настраивается в _Game/Data/Combat/Enemies/da_ability_tongs.tres,
## сам полёт рисует узел [TongsNode].
class_name TongsAbility
extends Resource

## Сколько ингредиентов уносится за одно применение.
@export var steal_count := 2

@export_group("Вид")
## Щипцы разжаты: с этим изображением они прилетают и наводятся на цель.
@export var open_texture: Texture2D
## Щипцы сомкнуты: изображение на время переноса ингредиента.
@export var close_texture: Texture2D
## Масштаб изображения на столе.
@export var image_scale := 0.13
## Отразить изображение по горизонтали (точка захвата остаётся на месте).
## Щипцы игрока прилетают слева, поэтому губки смотрят в другую сторону.
@export var mirror := false
## Точка захвата в долях изображения (0..1): место между губками. Именно она
## наводится на ингредиент, и за неё же ингредиент висит при переносе.
@export var grab_anchor := Vector2(0.295, 0.245)
## Слой отрисовки: выше стола и корзин (90/91), ниже HUD (100).
@export var draw_z_index := 96
## Слой ингредиента, пока его несут: под щипцами, но над столом.
@export var carried_z_index := 94

@export_group("Полёт")
## Точка появления и ухода — отступ от правого нижнего угла стола.
@export var entry_offset := Vector2(300.0, 280.0)
## Сколько длится подлёт к ингредиенту, с.
@export var approach_duration := 0.8
## Сколько длится перенос ингредиента на половину врага, с.
@export var carry_duration := 0.75
## Сколько длится уход со стола, с. Улетают щипцы всегда по прямой —
## без дуги и покачивания.
@export var retreat_duration := 0.6
## Кривизна траектории: отклонение середины пути вбок, px, и случайная
## добавка к нему (в обе стороны) — путь получается неровным.
@export var path_arc := 120.0
@export var path_arc_random := 80.0
## Мелкое покачивание в пути, px, и его скорость (колебаний за перелёт).
## К концу перелёта гаснет — губки приходят точно на ингредиент.
@export var wobble_amplitude := 20.0
@export var wobble_speed := 2.5
## Наклон щипцов в пути, рад.
@export var tilt := 0.14
## Пауза на смыкании губок и после того, как ингредиент отпущен, с.
@export var grab_pause := 0.22
@export var release_pause := 0.28
## С какой высоты ингредиент падает из разжатых губок, px.
@export var drop_height := 70.0
